{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Python Local Server",
            "type": "shell",
            "command": "python -m http.server 8080 -d ..",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*"
                }
            }
        }
    ]
}
